#. Key:	3AF0D41F4A047C6F6284DAB969925A1F
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Day_02.Text
#: /Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Day_02.Text
msgctxt ",3AF0D41F4A047C6F6284DAB969925A1F"
msgid "Great, have a nice day!"
msgstr "Great, have a nice day!"

#. Key:	A123CE03427EFA726AAE9992782196B0
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Day_03.Text
#: /Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Day_03.Text
msgctxt ",A123CE03427EFA726AAE9992782196B0"
msgid "This will do nicely. Bye!"
msgstr "This will do nicely. Bye!"

#. Key:	A57187344D5A5FD0DD1AB5B445A8C758
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_01.Text
#: /Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_01.Text
msgctxt ",A57187344D5A5FD0DD1AB5B445A8C758"
msgid "Thanks, goodnight!"
msgstr "Thanks, goodnight!"

#. Key:	9874061C42A31BDA99DB37BA2A5E9FA6
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_02.Text
#: /Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_02.Text
msgctxt ",9874061C42A31BDA99DB37BA2A5E9FA6"
msgid "See you tomorrow night."
msgstr "See you tomorrow night."

#. Key:	FA823C694FCA9930680B0CB60279B164
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_03.Text
#: /Game/DirectorsCut/Data/DT_FarewellLines.DT_FarewellLines.Farewell_Night_03.Text
msgctxt ",FA823C694FCA9930680B0CB60279B164"
msgid "Time to get home. Bye!"
msgstr "Time to get home. Bye!"

#. Key:	Brave_TooLittle_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_1.Text
msgctxt "DT_FeedbackLines,Brave_TooLittle_1_Text"
msgid "The hero hides in every scene. Be bolder."
msgstr "The hero hides in every scene. Be bolder."

#. Key:	Brave_TooLittle_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_2.Text
msgctxt "DT_FeedbackLines,Brave_TooLittle_2_Text"
msgid "Where is the courage? All I saw was waiting."
msgstr "Where is the courage? All I saw was waiting."

#. Key:	Brave_TooLittle_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooLittle_3.Text
msgctxt "DT_FeedbackLines,Brave_TooLittle_3_Text"
msgid "Nobody here takes a real risk."
msgstr "Nobody here takes a real risk."

#. Key:	Brave_TooMuch_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_1.Text
msgctxt "DT_FeedbackLines,Brave_TooMuch_1_Text"
msgid "The hero is reckless to the point of nonsense."
msgstr "The hero is reckless to the point of nonsense."

#. Key:	Brave_TooMuch_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_2.Text
msgctxt "DT_FeedbackLines,Brave_TooMuch_2_Text"
msgid "Bravery is fine but these stunts are just reckless."
msgstr "Bravery is fine but these stunts are just reckless."

#. Key:	Brave_TooMuch_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Brave_TooMuch_3.Text
msgctxt "DT_FeedbackLines,Brave_TooMuch_3_Text"
msgid "Every problem is solved by charging head first. Tiring."
msgstr "Every problem is solved by charging head first. Tiring."

#. Key:	Funny_TooLittle_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_1.Text
msgctxt "DT_FeedbackLines,Funny_TooLittle_1_Text"
msgid "Could have been a lot funnier."
msgstr "Could have been a lot funnier."

#. Key:	Funny_TooLittle_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_2.Text
msgctxt "DT_FeedbackLines,Funny_TooLittle_2_Text"
msgid "I did not crack a single smile."
msgstr "I did not crack a single smile."

#. Key:	Funny_TooLittle_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooLittle_3.Text
msgctxt "DT_FeedbackLines,Funny_TooLittle_3_Text"
msgid "The jokes landed in some other theater."
msgstr "The jokes landed in some other theater."

#. Key:	Funny_TooMuch_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_1.Text
msgctxt "DT_FeedbackLines,Funny_TooMuch_1_Text"
msgid "Less slapstick and more story please."
msgstr "Less slapstick and more story please."

#. Key:	Funny_TooMuch_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_2.Text
msgctxt "DT_FeedbackLines,Funny_TooMuch_2_Text"
msgid "It is a comedy that forgot to be a movie."
msgstr "It is a comedy that forgot to be a movie."

#. Key:	Funny_TooMuch_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Funny_TooMuch_3.Text
msgctxt "DT_FeedbackLines,Funny_TooMuch_3_Text"
msgid "Every scene is a punchline. Exhausting."
msgstr "Every scene is a punchline. Exhausting."

#. Key:	Romantic_TooLittle_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_1.Text
msgctxt "DT_FeedbackLines,Romantic_TooLittle_1_Text"
msgid "Not a single spark between the leads."
msgstr "Not a single spark between the leads."

#. Key:	Romantic_TooLittle_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_2.Text
msgctxt "DT_FeedbackLines,Romantic_TooLittle_2_Text"
msgid "I was rooting for a kiss that never came."
msgstr "I was rooting for a kiss that never came."

#. Key:	Romantic_TooLittle_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooLittle_3.Text
msgctxt "DT_FeedbackLines,Romantic_TooLittle_3_Text"
msgid "Cold romance. Even the couple seemed bored."
msgstr "Cold romance. Even the couple seemed bored."

#. Key:	Romantic_TooMuch_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_1.Text
msgctxt "DT_FeedbackLines,Romantic_TooMuch_1_Text"
msgid "Enough with the love scenes. The plot is missing."
msgstr "Enough with the love scenes. The plot is missing."

#. Key:	Romantic_TooMuch_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_2.Text
msgctxt "DT_FeedbackLines,Romantic_TooMuch_2_Text"
msgid "Syrupy. My teeth hurt."
msgstr "Syrupy. My teeth hurt."

#. Key:	Romantic_TooMuch_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Romantic_TooMuch_3.Text
msgctxt "DT_FeedbackLines,Romantic_TooMuch_3_Text"
msgid "The romance swallowed the whole film."
msgstr "The romance swallowed the whole film."

#. Key:	Scary_TooLittle_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_1.Text
msgctxt "DT_FeedbackLines,Scary_TooLittle_1_Text"
msgid "Nothing here would frighten a sleeping cat."
msgstr "Nothing here would frighten a sleeping cat."

#. Key:	Scary_TooLittle_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_2.Text
msgctxt "DT_FeedbackLines,Scary_TooLittle_2_Text"
msgid "Where is the dread? I am still waiting for it."
msgstr "Where is the dread? I am still waiting for it."

#. Key:	Scary_TooLittle_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooLittle_3.Text
msgctxt "DT_FeedbackLines,Scary_TooLittle_3_Text"
msgid "Too safe. I wanted to check under my bed afterwards."
msgstr "Too safe. I wanted to check under my bed afterwards."

#. Key:	Scary_TooMuch_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_1.Text
msgctxt "DT_FeedbackLines,Scary_TooMuch_1_Text"
msgid "Way too scary for me."
msgstr "Way too scary for me."

#. Key:	Scary_TooMuch_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_2.Text
msgctxt "DT_FeedbackLines,Scary_TooMuch_2_Text"
msgid "I had to leave the room twice. Not a compliment."
msgstr "I had to leave the room twice. Not a compliment."

#. Key:	Scary_TooMuch_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Scary_TooMuch_3.Text
msgctxt "DT_FeedbackLines,Scary_TooMuch_3_Text"
msgid "Subtle would have been nice. This was a fright attack."
msgstr "Subtle would have been nice. This was a fright attack."

#. Key:	Thoughtful_TooLittle_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_1.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooLittle_1_Text"
msgid "Pretty to look at but nothing to think about afterwards."
msgstr "Pretty to look at but nothing to think about afterwards."

#. Key:	Thoughtful_TooLittle_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_2.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooLittle_2_Text"
msgid "The plot never asks anything of me."
msgstr "The plot never asks anything of me."

#. Key:	Thoughtful_TooLittle_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooLittle_3.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooLittle_3_Text"
msgid "Shallow. I expected a little more to chew on."
msgstr "Shallow. I expected a little more to chew on."

#. Key:	Thoughtful_TooMuch_1_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_1.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_1.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooMuch_1_Text"
msgid "Too much talking. I came for a movie not a lecture."
msgstr "Too much talking. I came for a movie not a lecture."

#. Key:	Thoughtful_TooMuch_2_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_2.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_2.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooMuch_2_Text"
msgid "I got lost in the metaphors and gave up."
msgstr "I got lost in the metaphors and gave up."

#. Key:	Thoughtful_TooMuch_3_Text
#. SourceLocation:	/Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_3.Text
#: /Game/DirectorsCut/Data/DT_FeedbackLines.DT_FeedbackLines.Thoughtful_TooMuch_3.Text
msgctxt "DT_FeedbackLines,Thoughtful_TooMuch_3_Text"
msgid "Heavy handed. Just tell me the story."
msgstr "Heavy handed. Just tell me the story."

