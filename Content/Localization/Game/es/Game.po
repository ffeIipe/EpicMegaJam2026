#. Key:	54F29A0E4129A0745F4E2DAD21809938
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_01.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_01.Text
msgctxt ",54F29A0E4129A0745F4E2DAD21809938"
msgid "Hi there! Got a minute?"
msgstr "¡Hola! ¿Tienes un minuto?"

#. Key:	2AFA8AC842BCF574CC6C92A89063B59A
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_02.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_02.Text
msgctxt ",2AFA8AC842BCF574CC6C92A89063B59A"
msgid "Good afternoon! I am looking for a tape."
msgstr "¡Buenas tardes! Estoy buscando una cinta."

#. Key:	40D80D7C4F108577672C9A9D88B3F468
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_03.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Day_03.Text
msgctxt ",40D80D7C4F108577672C9A9D88B3F468"
msgid "Hey! Is this the place with the good movies?"
msgstr "¡Buenas! ¿Aquí es donde tienen las buenas películas?"

#. Key:	C1378A6F4EFBAF93275B4FBB775FF634
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_01.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_01.Text
msgctxt ",C1378A6F4EFBAF93275B4FBB775FF634"
msgid "Sorry, are you still open?"
msgstr "Disculpa, ¿todavía está abierto?"

#. Key:	FB80C7154D83EFD620233A8EAA139F96
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_02.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_02.Text
msgctxt ",FB80C7154D83EFD620233A8EAA139F96"
msgid "Quiet night, huh? Perfect for a movie."
msgstr "Noche tranquila, ¿eh? Perfecta para ver una película."

#. Key:	7FA7D38B473B7D69498E68BA678DBD6B
#. SourceLocation:	/Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_03.Text
#: /Game/DirectorsCut/Data/DT_Greetings.DT_Greetings.Greeting_Night_03.Text
msgctxt ",7FA7D38B473B7D69498E68BA678DBD6B"
msgid "Hi... I could not sleep."
msgstr "Hola... no podía dormir."

#. Key:	5A6A32A74D3ECE9E8854028B9FC73C3C
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_01.Text
msgctxt ",5A6A32A74D3ECE9E8854028B9FC73C3C"
msgid "Nothing loud. My head is already pounding."
msgstr "Nada ruidoso. Ya me duele bastante la cabeza."

#. Key:	0C9F74904C51F617BF5C9B83E12FEDF6
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_02.Text
msgctxt ",0C9F74904C51F617BF5C9B83E12FEDF6"
msgid "No fistfights or car chases, thanks."
msgstr "Sin peleas a puños ni persecuciones en auto, gracias."

#. Key:	0B0AFDE041E97FBB588D0B888EA3A01A
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Dislikes_03.Text
msgctxt ",0B0AFDE041E97FBB588D0B888EA3A01A"
msgid "I would like to hear the actors talk, not shoot."
msgstr "Quiero escuchar hablar a los actores, no disparar."

#. Key:	B1A84491493A6C9E92929B8F8EB1911C
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_01.Text
msgctxt ",B1A84491493A6C9E92929B8F8EB1911C"
msgid "Explosions. Car chases. Fists. In any order."
msgstr "Explosiones. Persecuciones. Puñetazos. En cualquier orden."

#. Key:	6E480D83442B547B37A56F8F3E0A2B74
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_02.Text
msgctxt ",6E480D83442B547B37A56F8F3E0A2B74"
msgid "I want my pulse racing from the first minute."
msgstr "Quiero que se me acelere el pulso desde el primer minuto."

#. Key:	D4868FAB4B234F64D237E1B474755FDF
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Likes_03.Text
msgctxt ",D4868FAB4B234F64D237E1B474755FDF"
msgid "Give me a hero who never runs out of bullets."
msgstr "Dame un héroe al que nunca se le acaben las balas."

#. Key:	7FC93BE04CD477BAB7E078A326C8EE0E
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_01.Text
msgctxt ",7FC93BE04CD477BAB7E078A326C8EE0E"
msgid "Some excitement would be nice. Not a war, though."
msgstr "Un poco de emoción estaría bien. Aunque tampoco una guerra."

#. Key:	F9D34CBE4222D0013738F3AB2F496964
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_02.Text
msgctxt ",F9D34CBE4222D0013738F3AB2F496964"
msgid "A chase or two would keep me awake."
msgstr "Una o dos persecuciones me mantendrían despierto."

#. Key:	5A28993E4FB500877E5E699CFA1C2C5B
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Action_Some_03.Text
msgctxt ",5A28993E4FB500877E5E699CFA1C2C5B"
msgid "I want a little adrenaline, but I don't need the whole show."
msgstr "Quiero algo de adrenalina, pero sin exagerar."

#. Key:	0ED0A52643C575CDF5CF498E110C59C4
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_01.Text
msgctxt ",0ED0A52643C575CDF5CF498E110C59C4"
msgid "Nothing goofy. I am not in the mood for jokes."
msgstr "Nada bobo. No estoy de humor para chistes."

#. Key:	A867478647D8E1BA67083696EF247096
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_02.Text
msgctxt ",A867478647D8E1BA67083696EF247096"
msgid "I cannot stand slapstick. Keep it serious."
msgstr "No soporto las payasadas. Que sea seria."

#. Key:	597E243846A57016EA3895A4D3E97860
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Dislikes_03.Text
msgctxt ",597E243846A57016EA3895A4D3E97860"
msgid "Spare me the wisecracks and the laugh tracks."
msgstr "Ahórrame los chistes fáciles y las risas grabadas."

#. Key:	D6F84FA14251BDB7F11E3985D22EE616
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_01.Text
msgctxt ",D6F84FA14251BDB7F11E3985D22EE616"
msgid "It's been a rough week. I need to laugh."
msgstr "Fue una semana dura. Necesito reírme."

#. Key:	7024AA1142A26D645A986B9FABCF08A7
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_02.Text
msgctxt ",7024AA1142A26D645A986B9FABCF08A7"
msgid "Surprise me with something silly. I want to laugh until it hurts."
msgstr "Sorpréndeme con algo disparatado. Quiero reírme hasta que me duela."

#. Key:	09593F1F497145CEFA3697B3D266302F
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Likes_03.Text
msgctxt ",09593F1F497145CEFA3697B3D266302F"
msgid "Anything where somebody slips on a banana peel works for me."
msgstr "Cualquier cosa donde alguien resbale con una cáscara de plátano me sirve."

#. Key:	88BE8FA342362E9550870EAFCDD54EA2
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_01.Text
msgctxt ",88BE8FA342362E9550870EAFCDD54EA2"
msgid "I could use a smile tonight. Nothing too wild."
msgstr "Me vendría bien sonreír esta noche. Nada demasiado alocado."

#. Key:	2934690B4780A408007D8AAE1C1ECEDA
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_02.Text
msgctxt ",2934690B4780A408007D8AAE1C1ECEDA"
msgid "Something light with a few good laughs."
msgstr "Algo ligero con un par de buenas risas."

#. Key:	42418FB148B996453B7806BDA9CC1FD7
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Comedy_Some_03.Text
msgctxt ",42418FB148B996453B7806BDA9CC1FD7"
msgid "A chuckle or two would make my evening."
msgstr "Un par de risas me alegrarían la noche."

#. Key:	23C432FD4FDF288A431D3E90F24AB05A
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_01.Text
msgctxt ",23C432FD4FDF288A431D3E90F24AB05A"
msgid "Nothing heavy tonight. I have had a long day."
msgstr "Nada pesado esta noche. Tuve un día largo."

#. Key:	BD49B8BF434D9095979A85B3C44E680F
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_02.Text
msgctxt ",BD49B8BF434D9095979A85B3C44E680F"
msgid "No tearjerkers. I am crying enough already."
msgstr "Nada de dramas lacrimógenos. Ya lloro bastante por mi cuenta."

#. Key:	9EC42A6D46ECEB79F7A71CBE2F998982
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Dislikes_03.Text
msgctxt ",9EC42A6D46ECEB79F7A71CBE2F998982"
msgid "I do not want to think tonight. Nothing deep, please."
msgstr "Esta noche no quiero pensar. Nada profundo, por favor."

#. Key:	DC8F1932420D38638D657C8E3AA66D46
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_01.Text
msgctxt ",DC8F1932420D38638D657C8E3AA66D46"
msgid "I am in the mood for something that makes me think."
msgstr "Tengo ganas de ver algo que me haga pensar."

#. Key:	51D6ED184ACC4EC832902BBCF6A7288F
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_02.Text
msgctxt ",51D6ED184ACC4EC832902BBCF6A7288F"
msgid "Bring tissues. I want a story that sticks with me."
msgstr "Trae pañuelos. Quiero una historia que me deje pensando."

#. Key:	5CD2DD3842A6B1894546C3A637C88DCB
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Likes_03.Text
msgctxt ",5CD2DD3842A6B1894546C3A637C88DCB"
msgid "Real people, real problems. That is what I want."
msgstr "Gente real, problemas reales. Eso es lo que busco."

#. Key:	0E8E44F447AFF766EA5914810B546C34
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_01.Text
msgctxt ",0E8E44F447AFF766EA5914810B546C34"
msgid "Something with a bit of heart to it, please."
msgstr "Algo con un poco de corazón, por favor."

#. Key:	2A5EEC444CB3B918E901678012169370
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_02.Text
msgctxt ",2A5EEC444CB3B918E901678012169370"
msgid "A story with some meaning, but nothing too heavy."
msgstr "Una historia con algo de profundidad, pero sin ser demasiado densa."

#. Key:	C282E18D48DD6140FAC57191DED6ABD6
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Drama_Some_03.Text
msgctxt ",C282E18D48DD6140FAC57191DED6ABD6"
msgid "I'd like to feel something by the end. A little."
msgstr "Me gustaría sentir algo al final. Aunque sea un poco."

#. Key:	CA5F682D45EF2EEFA56EA9AAD6E71F50
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_01.Text
msgctxt ",CA5F682D45EF2EEFA56EA9AAD6E71F50"
msgid "I want to sleep tonight, if you know what I mean."
msgstr "Quiero dormir esta noche, si sabes a lo que me refiero."

#. Key:	B88B70924000966414072D858640E971
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_02.Text
msgctxt ",B88B70924000966414072D858640E971"
msgid "Nothing that makes me jump. My nerves cannot take it."
msgstr "Nada que me haga saltar del sillón. Mis nervios no lo aguantan."

#. Key:	53B7442346B9DE200D9DBBBEB4FBB8C8
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Dislikes_03.Text
msgctxt ",53B7442346B9DE200D9DBBBEB4FBB8C8"
msgid "No blood, no monsters, no creepy dolls. Please."
msgstr "Sin sangre, sin monstruos, sin muñecos tenebrosos. Por favor."

#. Key:	68594622449DF740DA8526AF084989A1
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_01.Text
msgctxt ",68594622449DF740DA8526AF084989A1"
msgid "Turn the lights down. I want to be scared out of my seat."
msgstr "Apaga las luces. Quiero morirme del susto."

#. Key:	94291B0043AF7FAA847B90B45CBD14E7
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_02.Text
msgctxt ",94291B0043AF7FAA847B90B45CBD14E7"
msgid "Something that will make me check the closet tonight."
msgstr "Algo que me haga revisar el armario esta noche."

#. Key:	F55BADC44F47EC2E2E67EFAB2D345DDD
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Likes_03.Text
msgctxt ",F55BADC44F47EC2E2E67EFAB2D345DDD"
msgid "I want to scream a little. Safely, from the couch."
msgstr "Quiero gritar un poco. A salvo, desde el sofá."

#. Key:	EA8A8A1944556326ADB12A91AAEC47B6
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_01.Text
msgctxt ",EA8A8A1944556326ADB12A91AAEC47B6"
msgid "A little chill down the spine would be nice."
msgstr "Un pequeño escalofrío en la espalda estaría bien."

#. Key:	680AE7744EDF0D9CDD50E995009C58CC
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_02.Text
msgctxt ",680AE7744EDF0D9CDD50E995009C58CC"
msgid "Something spooky, but I still want to sleep."
msgstr "Algo inquietante, pero igual quiero poder dormir."

#. Key:	F71D978244EE849C13D9D88448CBC061
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Horror_Some_03.Text
msgctxt ",F71D978244EE849C13D9D88448CBC061"
msgid "Keep the lights on, but make it a bit creepy."
msgstr "Deja las luces encendidas, pero que dé algo de yuyu."

#. Key:	D93351F84077E9F0C7D584985D10AE5E
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_01.Text
msgctxt ",D93351F84077E9F0C7D584985D10AE5E"
msgid "Nothing about ghosts. I live alone."
msgstr "Nada de fantasmas. Vivo solo."

#. Key:	5B3D12FE48ECA071489260B1D8738076
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_02.Text
msgctxt ",5B3D12FE48ECA071489260B1D8738076"
msgid "No haunted anything. I need to sleep tonight."
msgstr "Nada embrujado. Necesito dormir esta noche."

#. Key:	9FAA71C3432E01E4F231749D01D99686
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Dislikes_03.Text
msgctxt ",9FAA71C3432E01E4F231749D01D99686"
msgid "I do not buy supernatural stuff. Keep it believable."
msgstr "No me creo lo sobrenatural. Que sea creíble."

#. Key:	5248CCC7424F0F6FF1B6B997BF62F1A1
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_01.Text
msgctxt ",5248CCC7424F0F6FF1B6B997BF62F1A1"
msgid "Ghosts, haunted houses, strange noises at night."
msgstr "Fantasmas, casas embrujadas, ruidos extraños por la noche."

#. Key:	91F8C0594CB5B5319B5B839739B22ED4
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_02.Text
msgctxt ",91F8C0594CB5B5319B5B839739B22ED4"
msgid "Do you believe in the unexplained? I do."
msgstr "¿Crees en lo inexplicable? Yo sí."

#. Key:	EC86508E47A5565EB43E69B852E5CB90
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Paranormal_Likes_03.Text
msgctxt ",EC86508E47A5565EB43E69B852E5CB90"
msgid "Something with spirits and a good seance."
msgstr "Algo con espíritus y una buena sesión espiritista."

#. Key:	A47261EE42A48EC3C1FFBD8D4BDA2C2D
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_01.Text
msgctxt ",A47261EE42A48EC3C1FFBD8D4BDA2C2D"
msgid "No mushy stuff, please. It gives me a sugar rush."
msgstr "Nada cursi, por favor. Me empalaga demasiado."

#. Key:	96E661A44382AC06FA63F888C6F7D126
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_02.Text
msgctxt ",96E661A44382AC06FA63F888C6F7D126"
msgid "Skip the love stories. I have had enough heartbreak."
msgstr "Sáltate las historias de amor. Ya tuve suficientes desengaños."

#. Key:	4B90C31948E0DD4E14EE4EA5BE943408
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Dislikes_03.Text
msgctxt ",4B90C31948E0DD4E14EE4EA5BE943408"
msgid "If anyone says I love you in it, I am leaving."
msgstr "Si alguien dice 'te amo', me voy."

#. Key:	0664BFAE41F95B102560D7B3A1A1F350
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_01.Text
msgctxt ",0664BFAE41F95B102560D7B3A1A1F350"
msgid "Something to watch with my date. Make it sweet."
msgstr "Algo para ver con mi cita. Que sea dulce."

#. Key:	F4B26102499FEEA410A12F8CC9FC7471
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_02.Text
msgctxt ",F4B26102499FEEA410A12F8CC9FC7471"
msgid "Got anything with love at first sight?"
msgstr "¿Tienes algo con amor a primera vista?"

#. Key:	9D51775D49C219B9F50235AE4EAD63D2
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Likes_03.Text
msgctxt ",9D51775D49C219B9F50235AE4EAD63D2"
msgid "I am a sucker for a kiss in the rain."
msgstr "Me pierden los besos bajo la lluvia."

#. Key:	AEF53C654836107535F93A92761E3E65
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_01.Text
msgctxt ",AEF53C654836107535F93A92761E3E65"
msgid "A touch of romance wouldn't hurt."
msgstr "Un toque de romance no vendría mal."

#. Key:	4622B41F449B92FD24284E9127CD1094
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_02.Text
msgctxt ",4622B41F449B92FD24284E9127CD1094"
msgid "Maybe a sweet moment or two. Nothing too mushy."
msgstr "Quizá un par de momentos dulces. Nada demasiado cursi."

#. Key:	07E44A6D405AAA5838A60882F8DAC0DE
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.Romance_Some_03.Text
msgctxt ",07E44A6D405AAA5838A60882F8DAC0DE"
msgid "A little spark between the leads would be nice."
msgstr "Un poco de química entre los protagonistas estaría bien."

#. Key:	BAAF19C3445EF4D64D1B54AE825DBD43
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_01.Text
msgctxt ",BAAF19C3445EF4D64D1B54AE825DBD43"
msgid "Keep it down to earth. No lasers, no aliens."
msgstr "Algo realista. Sin láseres ni extraterrestres."

#. Key:	DACEBC3441E96ECD6C767190DB73C3ED
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_02.Text
msgctxt ",DACEBC3441E96ECD6C767190DB73C3ED"
msgid "Anything with robots or spaceships is a no for me."
msgstr "Todo lo que tenga robots o naves espaciales es un no para mí."

#. Key:	61D6101945F1AC9505D7E79CEE83B9F7
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Dislikes_03.Text
msgctxt ",61D6101945F1AC9505D7E79CEE83B9F7"
msgid "I like my stories set in the here and now."
msgstr "Prefiero historias ambientadas en el aquí y ahora."

#. Key:	E0089B5D458F89F68395F3A0FEFEDEC1
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_01.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_01.Text
msgctxt ",E0089B5D458F89F68395F3A0FEFEDEC1"
msgid "Anything with spaceships? Robots? I'm not picky."
msgstr "¿Algo con naves espaciales? ¿Robots? No soy exigente."

#. Key:	171363D34285242480ABBDBA25C8C308
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_02.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_02.Text
msgctxt ",171363D34285242480ABBDBA25C8C308"
msgid "Take me to the future. Or to another galaxy."
msgstr "Llévame al futuro. O a otra galaxia."

#. Key:	D7DA48BE420BA02326C59C90CE95A53E
#. SourceLocation:	/Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_03.Text
#: /Game/DirectorsCut/Data/DT_HintLines.DT_HintLines.SciFi_Likes_03.Text
msgctxt ",D7DA48BE420BA02326C59C90CE95A53E"
msgid "I like to wonder what is out there among the stars."
msgstr "Me gusta imaginar qué hay allá afuera, entre las estrellas."

#. Key:	74430DB344F32C6C8CEA71A248BE2EC4
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_01.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_01.Text
msgctxt ",74430DB344F32C6C8CEA71A248BE2EC4"
msgid "Terrible. I want my money back."
msgstr "Horrible. Quiero que me devuelvan mi dinero."

#. Key:	394369D7478A5793C9B9B5978B05618C
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_02.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_02.Text
msgctxt ",394369D7478A5793C9B9B5978B05618C"
msgid "Not what I asked for at all. Never again."
msgstr "No era para nada lo que pedí. Nunca más."

#. Key:	A258DEE34D6F15D3341D6FAD57116973
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_03.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Hated_03.Text
msgctxt ",A258DEE34D6F15D3341D6FAD57116973"
msgid "I fell asleep. Then I woke up angry."
msgstr "Me quedé dormido. Y luego desperté enojado."

#. Key:	4555DCBA4CB49A55653F03A5BB99FCAD
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_01.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_01.Text
msgctxt ",4555DCBA4CB49A55653F03A5BB99FCAD"
msgid "Pretty good, would recommend."
msgstr "Bastante buena, la recomiendo."

#. Key:	A24483744F1149976EAACDA244833325
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_02.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_02.Text
msgctxt ",A24483744F1149976EAACDA244833325"
msgid "Not bad at all, I enjoyed it."
msgstr "Nada mal, la disfruté."

#. Key:	2676AC2544F2766BE3FC72BC05C6D987
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_03.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Liked_03.Text
msgctxt ",2676AC2544F2766BE3FC72BC05C6D987"
msgid "A solid pick. I will be back."
msgstr "Una elección sólida. Volveré."

#. Key:	2152983D446403E9782F0AB03CE39569
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_01.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_01.Text
msgctxt ",2152983D446403E9782F0AB03CE39569"
msgid "A masterpiece! I would rent it again tomorrow."
msgstr "¡Una obra maestra! La rentaría otra vez mañana."

#. Key:	47F141234DDE8C7823B01D91A84760C3
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_02.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_02.Text
msgctxt ",47F141234DDE8C7823B01D91A84760C3"
msgid "Five stars. Exactly what I was after."
msgstr "Cinco estrellas. Exactamente lo que buscaba."

#. Key:	F7FB76564C23D360FB75BDA598CF5070
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_03.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Loved_03.Text
msgctxt ",F7FB76564C23D360FB75BDA598CF5070"
msgid "I want to tell everyone about this tape."
msgstr "Quiero contarle a todo el mundo sobre esta cinta."

#. Key:	945F68C34D1896D5CD5682B3C745137A
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_01.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_01.Text
msgctxt ",945F68C34D1896D5CD5682B3C745137A"
msgid "It was fine. Nothing special."
msgstr "Estuvo bien. Nada del otro mundo."

#. Key:	FAC22F324A10945D31F7B7852B260EDB
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_02.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_02.Text
msgctxt ",FAC22F324A10945D31F7B7852B260EDB"
msgid "Not what I asked for, but I watched it."
msgstr "No era lo que pedí, pero igual la vi."

#. Key:	FF0325E44A1F5C6B22C247A8AF9BFF51
#. SourceLocation:	/Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_03.Text
#: /Game/DirectorsCut/Data/DT_ReviewLines.DT_ReviewLines.Review_Neutral_03.Text
msgctxt ",FF0325E44A1F5C6B22C247A8AF9BFF51"
msgid "Meh. I have seen better."
msgstr "Meh. He visto cosas mejores."

