msgstr "¡TUTORIAL COMPLETADO!"

#. Key:	Tutorial_CompleteBody
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1003)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1003)
msgctxt "DirectorsCut,Tutorial_CompleteBody"
msgid "You know clues, VHS combinations, genre unlocks, and supplier orders. Watch patience bars and cover tonight's rent!"
msgstr "Ya conoces las pistas, las combinaciones de VHS, los desbloqueos de géneros y los pedidos al proveedor. ¡Cuida la paciencia y paga la renta de hoy!"

#. Key:	Tutorial_CompleteAction
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1004)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1004)
msgctxt "DirectorsCut,Tutorial_CompleteAction"
msgid "Close the Supplier (Esc) - your next customer is on the way!"
msgstr "Cierra el Proveedor (Esc): ¡tu próximo cliente viene en camino!"

#. Key:	Tutorial_1_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1075)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1075)
msgctxt "DirectorsCut,Tutorial_1_Header"
msgid "TUTORIAL 1/6: FIRST CUSTOMER"
msgstr "TUTORIAL 1/6: PRIMER CLIENTE"

#. Key:	Tutorial_1_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1076)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1076)
msgctxt "DirectorsCut,Tutorial_1_Body"
msgid "Customers give mood clues - never exact skill or genre names. Turn toward them at the counter to talk."
msgstr "Los clientes dan pistas de ambiente, nunca nombres exactos de habilidades o géneros. Míralos en el mostrador para hablar."

#. Key:	Tutorial_1_ActionScreen
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1078)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1078)
msgctxt "DirectorsCut,Tutorial_1_ActionScreen"
msgid "Close this screen (Esc), look at the customer and press [{0}]"
msgstr "Cierra esta pantalla (Esc), mira al cliente y presiona [{0}]"

#. Key:	Tutorial_1_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1079)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1079)
msgctxt "DirectorsCut,Tutorial_1_Action"
msgid "Look at the customer and press [{0}] to listen"
msgstr "Mira al cliente y presiona [{0}] para escuchar"

#. Key:	Tutorial_1b_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1084)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1084)
msgctxt "DirectorsCut,Tutorial_1b_Header"
msgid "TUTORIAL 1/6: INTERPRET CLUES"
msgstr "TUTORIAL 1/6: INTERPRETA PISTAS"

#. Key:	Tutorial_1b_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1085)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1085)
msgctxt "DirectorsCut,Tutorial_1b_Body"
msgid "Clues map to hidden Skills (Funny, Scary, Brave...). Slapstick/laughs = Funny high; 'sleep tonight' / 'no scares' = Scary 0. Next you'll combine 2+ tapes to hit 6 pts."
msgstr "Las pistas indican Habilidades ocultas (Humor, Miedo, Valor...). Payasadas/risas = Humor alto; 'dormir esta noche' / 'sin sustos' = Miedo 0. Luego combinarás 2+ cintas para lograr 6 pts."

#. Key:	Tutorial_1b_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1086)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1086)
msgctxt "DirectorsCut,Tutorial_1b_Action"
msgid "Read the clues, then click 'Coming right up'"
msgstr "Lee las pistas y haz clic en 'Enseguida'"

#. Key:	Tutorial_2_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1097)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1097)
msgctxt "DirectorsCut,Tutorial_2_Header"
msgid "TUTORIAL 2/6: BACK ROOM"
msgstr "TUTORIAL 2/6: TRASTIENDA"

#. Key:	Tutorial_2_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1098)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1098)
msgctxt "DirectorsCut,Tutorial_2_Body"
msgid "The ORDER box (top-left) keeps their clues pinned. Head to the back room to combine 2+ VHS tapes into one 6-point film."
msgstr "El cuadro PEDIDO (arriba a la izquierda) guarda sus pistas. Ve a la trastienda para combinar 2+ cintas VHS en una película de 6 puntos."

#. Key:	Tutorial_2_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1099)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1099)
msgctxt "DirectorsCut,Tutorial_2_Action"
msgid "Press [{0}] to go to the back room"
msgstr "Presiona [{0}] para ir a la trastienda"

#. Key:	Tutorial_3a_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1109)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1109)
msgctxt "DirectorsCut,Tutorial_3a_Header"
msgid "TUTORIAL 3/6: INSPECT & PICK"
msgstr "TUTORIAL 3/6: REVISA Y ELIGE"

#. Key:	Tutorial_3a_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1110)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1110)
msgctxt "DirectorsCut,Tutorial_3a_Body"
msgid "Skills show right under each tape title. Pick tapes whose skills match the ORDER clues (here: Funny high, Scary zero)."
msgstr "Las habilidades salen bajo el título de cada cinta. Elige cintas cuyas habilidades encajen con el PEDIDO (aquí: Humor alto, Miedo cero)."

#. Key:	Tutorial_3a_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1111)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1111)
msgctxt "DirectorsCut,Tutorial_3a_Action"
msgid "Click a Comedy tape (Funny 3) to load Slot 1"
msgstr "Haz clic en una cinta de Comedia (Humor 3) para la Ranura 1"

#. Key:	Tutorial_3b_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1116)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1116)
msgctxt "DirectorsCut,Tutorial_3b_Header"
msgid "TUTORIAL 3/6: SKILLS ADD UP"
msgstr "TUTORIAL 3/6: SE SUMAN"

#. Key:	Tutorial_3b_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1117)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1117)
msgctxt "DirectorsCut,Tutorial_3b_Body"
msgid "Slotted tapes add together in FILM PROFILE - and you can repeat copies of the same tape! Watch Order size & MATCH WITH THE ORDER."
msgstr "Las cintas se suman en PERFIL DE PELÍCULA, ¡y puedes repetir copias de la misma cinta! Vigila el tamaño y la COINCIDENCIA CON EL PEDIDO."

#. Key:	Tutorial_3b_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1118)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1118)
msgctxt "DirectorsCut,Tutorial_3b_Action"
msgid "Click a 2nd Comedy tape (repeats work!) so MATCH turns GREAT"
msgstr "Elige una 2.ª cinta de Comedia (¡puedes repetir!) para lograr GENIAL"

#. Key:	Tutorial_3c_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1132)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1132)
msgctxt "DirectorsCut,Tutorial_3c_Header"
msgid "TUTORIAL 3/6: COMBINE FILM"
msgstr "TUTORIAL 3/6: COMBINAR PELÍCULA"

#. Key:	Tutorial_3c_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1133)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1133)
msgctxt "DirectorsCut,Tutorial_3c_Body"
msgid "MATCH WITH THE ORDER looks great! Edit the title if you want - combining consumes the slotted tape copies."
msgstr "¡La COINCIDENCIA CON EL PEDIDO se ve genial! Edita el título si quieres: combinar consume las copias usadas."

#. Key:	Tutorial_3c_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1134)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1134)
msgctxt "DirectorsCut,Tutorial_3c_Action"
msgid "Click COMBINE to return to the counter with your film"
msgstr "Haz clic en COMBINAR para volver al mostrador con tu película"

#. Key:	Tutorial_3d_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1139)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1139)
msgctxt "DirectorsCut,Tutorial_3d_Header"
msgid "TUTORIAL 3/6: CHECK THE MATCH"
msgstr "TUTORIAL 3/6: REVISA EL AJUSTE"

#. Key:	Tutorial_3d_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1140)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1140)
msgctxt "DirectorsCut,Tutorial_3d_Body"
msgid "MATCH WITH THE ORDER is low. Click 'x' next to a slot to swap tapes until Funny is high and Scary stays 0."
msgstr "La COINCIDENCIA CON EL PEDIDO es baja. Haz clic en 'x' junto a una ranura para cambiar cintas hasta tener Humor alto y Miedo en 0."

#. Key:	Tutorial_3d_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1141)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1141)
msgctxt "DirectorsCut,Tutorial_3d_Action"
msgid "Swap tapes with 'x' or click COMBINE when ready"
msgstr "Cambia cintas con 'x' o haz clic en COMBINAR cuando estés listo"

#. Key:	Tutorial_4a_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1155)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1155)
msgctxt "DirectorsCut,Tutorial_4a_Header"
msgid "TUTORIAL 4/6: DELIVERY & PAY"
msgstr "TUTORIAL 4/6: ENTREGA Y PAGO"

#. Key:	Tutorial_4a_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1156)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1156)
msgctxt "DirectorsCut,Tutorial_4a_Body"
msgid "Base rental (${0}) pays immediately. Bonus tips (or fines!) arrive shortly after on ReelTalk.net."
msgstr "La renta base (${0}) se paga al instante. Las propinas (¡o multas!) llegan poco después en ReelTalk.net."

#. Key:	Tutorial_4a_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1157)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1157)
msgctxt "DirectorsCut,Tutorial_4a_Action"
msgid "Click 'Here you go' to deliver your film"
msgstr "Haz clic en 'Aquí tienes' para entregar tu película"

#. Key:	Tutorial_4b_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1162)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1162)
msgctxt "DirectorsCut,Tutorial_4b_Header"
msgid "TUTORIAL 4/6: HAND OVER FILM"
msgstr "TUTORIAL 4/6: ENTREGA LA CINTA"

#. Key:	Tutorial_4b_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1163)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1163)
msgctxt "DirectorsCut,Tutorial_4b_Body"
msgid "Your combined VHS is ready! Base rental pays on delivery; tips (or fines) arrive with the customer's review."
msgstr "¡Tu VHS combinado está listo! La renta base se paga al entregar; las propinas (o multas) llegan con la reseña."

#. Key:	Tutorial_4b_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1164)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1164)
msgctxt "DirectorsCut,Tutorial_4b_Action"
msgid "Look at the customer and press [{0}] to deliver"
msgstr "Mira al cliente y presiona [{0}] para entregar"

#. Key:	Tutorial_4c_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1170)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1170)
msgctxt "DirectorsCut,Tutorial_4c_Header"
msgid "TUTORIAL 4/6: REELTALK REVIEW"
msgstr "TUTORIAL 4/6: RESEÑA REELTALK"

#. Key:	Tutorial_4c_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1171)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1171)
msgctxt "DirectorsCut,Tutorial_4c_Body"
msgid "Base rent is paid! Customers post star ratings, bonus tips (or fines), and missing-skill feedback on ReelTalk.net."
msgstr "¡Renta base pagada! Los clientes publican estrellas, propinas (o multas) y comentarios en ReelTalk.net."

#. Key:	Tutorial_4c_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1172)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1172)
msgctxt "DirectorsCut,Tutorial_4c_Action"
msgid "Wait a moment for the customer's review..."
msgstr "Espera un momento la reseña del cliente..."

#. Key:	Tutorial_5a_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1179)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1179)
msgctxt "DirectorsCut,Tutorial_5a_Header"
msgid "TUTORIAL 5/6: SHOP UPGRADES"
msgstr "TUTORIAL 5/6: MEJORAS DE TIENDA"

#. Key:	Tutorial_5a_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1180)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1180)
msgctxt "DirectorsCut,Tutorial_5a_Body"
msgid "GENRES adds genres to your catalog (future customers ask for them!). COMBINE MACHINE adds slots; STAR LICENSES raise tape tier."
msgstr "GÉNEROS añade géneros al catálogo (¡pronto los pedirán!). MÁQUINA COMBINADORA suma ranuras; LICENCIAS DE ESTRELLAS suben el nivel."

#. Key:	Tutorial_5a_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1181)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1181)
msgctxt "DirectorsCut,Tutorial_5a_Action"
msgid "On the GENRES tab, buy a new genre (e.g. ROMANCE for $40)"
msgstr "En GÉNEROS, compra un nuevo género (ej. ROMANCE por $40)"

#. Key:	Tutorial_5b_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1186)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1186)
msgctxt "DirectorsCut,Tutorial_5b_Header"
msgid "TUTORIAL 5/6: OPEN COMPUTER"
msgstr "TUTORIAL 5/6: ABRE LA COMPUTADORA"

#. Key:	Tutorial_5b_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1187)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1187)
msgctxt "DirectorsCut,Tutorial_5b_Body"
msgid "See ReelTalk.net above - tips boost your cash and Criterio! Now unlock a new genre on the Computer."
msgstr "¡Mira ReelTalk.net arriba! Las propinas suben tu dinero y Criterio. Ahora desbloquea un género en la Computadora."

#. Key:	Tutorial_5b_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1188)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1188)
msgctxt "DirectorsCut,Tutorial_5b_Action"
msgid "Look at the COMPUTER on the counter and press [{0}]"
msgstr "Mira la COMPUTADORA en el mostrador y presiona [{0}]"

#. Key:	Tutorial_6a_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1196)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1196)
msgctxt "DirectorsCut,Tutorial_6a_Header"
msgid "TUTORIAL 6/6: SUPPLIER STOCK"
msgstr "TUTORIAL 6/6: SURTIR CINTAS"

#. Key:	Tutorial_6a_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1197)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1197)
msgctxt "DirectorsCut,Tutorial_6a_Body"
msgid "Switch Genre tabs (try your new genre!) and filter by stars. Skills show below each tape - x1 buys one copy, x5 buys five."
msgstr "Cambia de pestaña de Género (¡prueba el nuevo!) y filtra por estrellas. x1 compra una copia, x5 compra cinco."

#. Key:	Tutorial_6a_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1198)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1198)
msgctxt "DirectorsCut,Tutorial_6a_Action"
msgid "Buy any tape (x1 or x5) to stock your shelf and finish!"
msgstr "¡Compra cualquier cinta (x1 o x5) para surtir tu estante y terminar!"

#. Key:	Tutorial_6b_Header
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1203)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1203)
msgctxt "DirectorsCut,Tutorial_6b_Header"
msgid "TUTORIAL 6/6: BUY FROM SUPPLIER"
msgstr "TUTORIAL 6/6: COMPRA AL PROVEEDOR"

#. Key:	Tutorial_6b_Body
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1204)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1204)
msgctxt "DirectorsCut,Tutorial_6b_Body"
msgid "Unlocking a genre on the Computer does NOT add copies to stock! You must order physical tapes at the Cash Register."
msgstr "Desbloquear un género en la Computadora NO añade copias al inventario. Debes pedir cintas en la Caja Registradora."

#. Key:	Tutorial_6b_ActionScreen
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1206)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1206)
msgctxt "DirectorsCut,Tutorial_6b_ActionScreen"
msgid "Close Computer (Esc), look at the CASH REGISTER and press [{0}]"
msgstr "Cierra la Computadora (Esc), mira la CAJA REGISTRADORA y presiona [{0}]"

#. Key:	Tutorial_6b_Action
#. SourceLocation:	Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1207)
#: Source/EpicMegaJam2026/Core/DCPlayerController.cpp(1207)
msgctxt "DirectorsCut,Tutorial_6b_Action"
msgid "Look at the CASH REGISTER and press [{0}] to open Supplier"
msgstr "Mira la CAJA REGISTRADORA y presiona [{0}] para abrir el Proveedor"

